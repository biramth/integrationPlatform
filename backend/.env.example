PORT=3000
JWT_SECRET=change-me-in-production
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-xxxx.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxx
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=changeme123

# Certificat CA Supabase pour vérification SSL de la connexion DB.
# Laisser vide en dev (fallback rejectUnauthorized: false).
# En prod Render : copier le contenu du certificat Supabase (supabase-ca.crt).
SUPABASE_CA_CERT=

# Origines autorisées à appeler l'API (frontend Vercel), séparées par des virgules.
# Vide en local = toutes les origines acceptées.
CORS_ORIGIN=
